DATABASE_URL=postgresql://incidents:incidents@localhost:5432/incidents
OPENAI_API_KEY=sk-your-key-here
ENVIRONMENT=development
LOG_LEVEL=INFO
# CORS origins as a comma-separated list. Default is "*" (credentials disabled
# while wildcard). For production, set explicit origins, e.g.
# CORS_ORIGINS=https://app.example.com
CORS_ORIGINS=*
LLM_MODEL=gpt-4o-mini
SCAN_TMP_DIR=./.scan-tmp
MAX_REPO_SIZE_MB=50
MAX_SCAN_FILES=2000
MAX_LLM_FILES=10
MAX_LLM_FILE_CHARS=12000
MAX_LLM_INPUT_CHARS=600000
SCAN_ALLOWED_HOSTS=github.com,gitlab.com,bitbucket.org
SCAN_MAX_CONCURRENT=2